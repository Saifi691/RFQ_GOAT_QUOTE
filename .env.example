# Copy to .env; never commit credentials.
BOT_EMAIL=
BOT_PASSWORD=
# Dashboard simulation: a SECOND Gmail account that sends test RFQs to BOT_EMAIL (App Password, 16 letters).
SIM_SENDER_EMAIL=
SIM_SENDER_PASSWORD=
RFQ_QUALITY=rules
# Set quality to ai and provide an API key and a Responses-compatible model.
OPENAI_API_KEY=
OPENAI_MODEL=
# Scraping mode: live = visible Chrome on CHROME_CDP_URL (start it first), background = hidden Chrome the app starts.
RFQ_MODE=background
RFQ_DEMO_DELAY=2
RFQ_PAGE_PAUSE=2
RFQ_PAGE_TIMEOUT=30
RFQ_BACKGROUND_PORT=9334
# Optional: path to chrome.exe if it is not in the standard location.
CHROME_PATH=
OPENAI_TIMEOUT=120
CHROME_CDP_URL=http://127.0.0.1:9333
# Ferguson internal product service (reachable on the Ferguson network/VPN only; batches of 100 IDs).
RFQ_PRODUCT_API=true
RFQ_PRODUCT_API_URL=https://feidtifaks001.feiaz.ferguson.com/tif-developers-devtrunk/product-info-v3/svc/
# TLS is checked against the Windows certificate store. Set false only if your network requires it.
RFQ_PRODUCT_API_VERIFY=true
RFQ_PRODUCT_API_TIMEOUT=20
RFQ_BROWSER=true
RFQ_PDFS=true
RFQ_OFFLINE=false
RFQ_TIMEOUT=12
# Leave empty to accept RFQs from all human senders. Comma-separated addresses.
RFQ_ALLOWED_SENDERS=
RFQ_MAIL_ENABLED=false
